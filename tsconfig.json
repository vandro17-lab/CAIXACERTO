{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": { "@dominio/*": ["./supabase/functions/api/dominio/*"] }
  },
  "include": ["src", "testes", "servidor-local", "supabase/functions/api", "vite.config.ts"],
  "exclude": ["supabase/functions/api/index.ts"]
}
